# EXEMPLO, sem senhas reais! Configurar no Render > Environment.
THIGAS_CLOUD_MODE=1
MARITACA_MODEL=sabiazinho-4-br-sp
MARITACA_API_KEY=COLOQUE_EXCLUSIVAMENTE_NO_RENDER
THIGAS_SITE_USER=thigas
THIGAS_SITE_PASSWORD=UMA_SENHA_DIFERENTE_DA_CHAVE_MARITACA
THIGAS_MAX_REQUESTS_HOUR=20
THIGAS_NANO_MAX_TOKENS=220
THIGAS_MINI_MAX_TOKENS=800
THIGAS_WIKI_CONTACT=
# Opcional: somente se hospedar separadamente o verdadeiro modelo THIGAS Mini.
# URL HTTPS pública terminada em /chat/completions, exemplo: https://seu-dominio/v1/chat/completions
# THIGAS_MINI_UPSTREAM_URL=
# THIGAS_MINI_API_KEY=
# THIGAS_MINI_MODEL=THIGAS_AI_mini
