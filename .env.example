# EXEMPLO, sem senhas reais! Configurar no Render > Environment.
THIGAS_CLOUD_MODE=1
MARITACA_MODEL=sabiazinho-4-br-sp
MARITACA_API_KEY=COLOQUE_EXCLUSIVAMENTE_NO_RENDER
# Chaves Groq opcionais: o roteador alterna provedores e chaves em cada pergunta.
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=CONFIGURE_SOMENTE_NO_RENDER
# GROQ_API_KEY_2=CONFIGURE_SOMENTE_NO_RENDER
# GROQ_API_KEY_3=CONFIGURE_SOMENTE_NO_RENDER
# MARITACA_API_KEY_2=CONFIGURE_SOMENTE_NO_RENDER
# Também aceita GROQ_API_KEY2, *_API_KEY_BACKUP ou GROQ_API_KEYS em JSON.
# O limite THIGAS_MAX_REQUESTS_HOUR permanece global; keys na mesma organização
# não multiplicam as cotas do provedor.
THIGAS_SITE_USER=thigas
THIGAS_SITE_PASSWORD=UMA_SENHA_DIFERENTE_DA_CHAVE_MARITACA
THIGAS_MAX_REQUESTS_HOUR=20
THIGAS_NANO_MAX_TOKENS=500
THIGAS_MINI_MAX_TOKENS=1150
THIGAS_WIKI_CONTACT=
# Modo Alto permite até cerca de 1.800 tokens de saída em nuvem.
# ATENÇÃO: mais tokens na API elevam custo; 20 solicitações/h não é teto de gasto.
# Opcional: somente se hospedar separadamente o verdadeiro modelo THIGAS Mini.
# URL HTTPS pública terminada em /chat/completions, exemplo: https://seu-dominio/v1/chat/completions
# THIGAS_MINI_UPSTREAM_URL=
# THIGAS_MINI_API_KEY=
# THIGAS_MINI_MODEL=THIGAS_AI_mini
